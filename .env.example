# ---------- Backend ----------
# Supabase is the single source of truth: Auth handles sign-in (email + password) and Postgres stores all data.
# Supabase (publishable key is safe for the browser; never put the secret/service_role key in NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_, never commit, never ship to the app.
# Supabase dashboard > Project Settings > API Keys > Secret key (sb_secret_..., or service_role on older projects).
# It bypasses RLS, which is how the backend reads and writes the locked-down tables. REQUIRED: the API refuses to run
# without it (it never falls back to in-memory storage). Set it in your host's environment variables too.
SUPABASE_SECRET_KEY=

# ---------- Frontend ----------
# Base URL the frontend uses to reach the backend (server-side / RSC calls).
API_BASE_URL=http://localhost:3000
# Browser calls (empty = same origin). Point to a separate service if the backend is ever split out.
NEXT_PUBLIC_API_BASE_URL=

# Public origin for canonical / Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Backend auth (server-only) ----------
# App sessions are Supabase Auth JWTs, verified against the project's JWKS. Only set this for a project still on the
# legacy shared JWT secret (Project settings > API > JWT secret).
SUPABASE_JWT_SECRET=
# Admins sign in with their normal Supabase account; access comes from users.role = 'admin'.
# Optional bootstrap: the account with this email gets the admin role when its profile is first created.
ADMIN_EMAIL=

# ---------- Photo storage (Cloudflare R2, or any S3-compatible service) ----------
# The iOS app compresses photos to WebP and uploads them straight to the bucket with presigned URLs, so image bytes
# never pass through this API. Leave S3_BUCKET unset to disable uploads (POST /api/v1/media/uploads answers 503).
#
# Cloudflare R2 setup:
#   1. R2 > Manage API tokens > create a token with "Object Read & Write" scoped to the bucket. Use its Access Key ID /
#      Secret Access Key below.
#   2. Bucket > Settings > enable the r2.dev subdomain (dev) or connect a custom domain (production) so photos can be read
#      publicly, and put that origin in S3_PUBLIC_BASE_URL. Uploads always go to the r2.cloudflarestorage.com endpoint.
#   3. S3_REGION is always "auto". S3_ENDPOINT is the account endpoint WITHOUT the bucket name.
S3_BUCKET=nearpaw
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public origin that serves `public/...` keys, e.g. https://pub-<hash>.r2.dev or https://media.example.com
# Returned to the app by GET /api/v1/config.
S3_PUBLIC_BASE_URL=

# ---------- Push notifications (Firebase Cloud Messaging) ----------
# The iOS app registers its FCM token; the API sends through FCM HTTP v1 (FCM relays to APNs).
# Firebase console > Project settings > Service accounts > "Generate new private key". Paste the JSON on one line
# (or base64-encode it). Unset = new-report alerts still appear in the in-app feed, but no push is sent.
# APNs: upload the APNs auth key (.p8) under Project settings > Cloud Messaging > Apple app configuration.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---------- Scheduled housekeeping (Vercel Cron) ----------
# Secret for GET /api/v1/cron/housekeeping, which deletes the photos of expired/closed/removed reports from the bucket and
# purges old rate-limit counters. Generate one with `openssl rand -hex 32` and set it in the Vercel project's environment
# variables: Vercel Cron then sends it as `Authorization: Bearer <CRON_SECRET>`. Unset = the endpoint answers 503.
CRON_SECRET=
